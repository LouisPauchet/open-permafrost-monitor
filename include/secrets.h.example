#pragma once

// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is git-ignored so credentials never get committed.
//
// These are only the *compiled-in seed defaults*, loaded once into NVS on
// the very first boot. There's no WiFi in the field build (Walter's cellular
// modem handles connectivity, see modem.h) - all values below can be
// changed later via the field-service config menu (field_service.h)
// without reflashing.

#define NTRIP_HOST "caster.example.com"
#define NTRIP_PORT 2101
#define NTRIP_MOUNTPOINT "MOUNTPOINT"
#define NTRIP_USER "username"
#define NTRIP_PASSWORD "password"

#define MQTT_HOST "mqtt.example.com"
#define MQTT_PORT 8883
#define MQTT_CLIENT_ID "esp32-permafrost-monitor"
#define MQTT_USER ""
#define MQTT_PASSWORD ""
#define MQTT_TOPIC "permafrost/gnss/position"
